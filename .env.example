# Copy to .env and fill in. Never commit .env.

# --- LLM provider for genuine discovery (replay never uses an LLM) ---
# "gemini" (default; Google free tier) or "anthropic"
LLM_PROVIDER=gemini

# Gemini (default provider) — free-tier key: https://aistudio.google.com/apikey
# gemini-3.6-flash is the model that produced the submitted genuine evidence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic (optional alternative provider)
ANTHROPIC_API_KEY=
DISCOVERY_MODEL=claude-fable-5

# --- Runtime ---
TARGET_BASE_URL=http://127.0.0.1:8001
OPERATOR_BASE_URL=http://127.0.0.1:8002
PLAYWRIGHT_HEADLESS=false
MAX_DISCOVERY_STEPS=20
DISCOVERY_TIMEOUT_SECONDS=180
DEFAULT_STEP_TIMEOUT_MS=5000
MAX_RECOVERY_ATTEMPTS=2
EVIDENCE_DIR=evidence
ARTIFACT_DIR=artifacts
LOG_LEVEL=INFO

# --- Phase 2: MERIDIAN CORE target ---
# Public sample application; contains no real credentials or PII.
MERIDIAN_BASE_URL=https://web-sample.interface-hiring.com
# Demo operators published by the assignment. Never persisted to artifacts,
# logs, or evidence; bound at invocation time only.
MERIDIAN_TELLER_ID=
MERIDIAN_TELLER_PASSWORD=
MERIDIAN_SUPERVISOR_ID=
MERIDIAN_SUPERVISOR_PASSWORD=
MERIDIAN_BRANCH=MAIN-001

# --- Phase 2: local service surfaces (capability API + chatbot + dashboard) ---
SERVICE_BASE_URL=http://127.0.0.1:8010
