# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
DISCOVERY_MODEL=claude-fable-5
TARGET_BASE_URL=http://127.0.0.1:8001
OPERATOR_BASE_URL=http://127.0.0.1:8002
