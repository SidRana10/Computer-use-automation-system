    },
    {
      "code": "TRANSACTION_REJECTED",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "The transaction could not be validated:",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "MERIDIAN rejected the transaction during validation (for example insufficient available balance in the source share)."
    },
    {
      "code": "FIELD_VALIDATION_FAILED",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "Please correct the following:",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "One or more submitted field values were rejected by MERIDIAN validation."
    },
    {
      "code": "VALIDATION_REJECTED",
      "classification": "business_outcome",
      "when": [
        {
