  "error_rules": [
    {
      "code": "BAD_LOGIN",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "Invalid operator ID or password.",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "The supplied operator credentials were rejected by MERIDIAN."
    },
    {
      "code": "SUPERVISOR_REQUIRED",
      "classification": "hard_failure",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "is not authorized to perform this function",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "MERIDIAN requires a supervisor profile for this function; the signed-on operator is not authorized and automation will not attempt to bypass it."
    },
    {
      "code": "SESSION_EXPIRED",
      "classification": "hard_failure",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "your session ended due to inactivity",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "The MERIDIAN session ended; re-authentication is required, so this run stops rather than resuming a flow whose state is unknown."
    },
    {
      "code": "MEMBER_NOT_FOUND",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "The requested member record could not be located on this host.",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "No MERIDIAN member record exists for that member number."
    },
    {
      "code": "NO_SEARCH_RESULTS",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "No member records matched your search.",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "The member inquiry returned no matching records."
    },
    {
      "code": "TRANSACTION_REJECTED",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "The transaction could not be validated:",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "MERIDIAN rejected the transaction during validation (for example insufficient available balance in the source share)."
    },
    {
      "code": "FIELD_VALIDATION_FAILED",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "Please correct the following:",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "One or more submitted field values were rejected by MERIDIAN validation."
    },
    {
      "code": "VALIDATION_REJECTED",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "The transaction could not be completed as entered.",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "MERIDIAN rejected the transaction as entered."
    },
    {
      "code": "OPEN_SHARE_VALIDATION_FAILED",
      "classification": "business_outcome",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "The request could not be validated:",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "MERIDIAN rejected the new-share request during validation (for example a deposit below the product's required minimum)."
    },
    {
      "code": "MAINTENANCE_WINDOW",
      "classification": "recoverable",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "The host is temporarily unavailable",
          "timeout_ms": 400
        }
      ],
      "recovery": [
        {
          "kind": "wait",
          "target": null,
          "wait_ms": 1500
        },
        {
          "kind": "reload",
          "target": null,
          "wait_ms": null
        }
      ],
      "max_attempts": 2,
      "caller_message": "MERIDIAN reported a maintenance window; waited and retried within budget."
    },
    {
      "code": "APPLICATION_ERROR",
      "classification": "hard_failure",
      "when": [
        {
          "kind": "text_present",
          "target": null,
          "value": "An unexpected error occurred while processing your request.",
          "timeout_ms": 400
        }
      ],
      "recovery": [],
      "max_attempts": 0,
      "caller_message": "MERIDIAN returned an application error; the run stopped and preserved evidence."
    }
  ],
