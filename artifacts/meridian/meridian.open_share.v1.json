{
  "schema_version": "1.0",
  "capability_id": "meridian.open_share",
  "capability_version": "1.0.0",
  "name": "Meridian Open Share",
  "description": "Sign on to MERIDIAN CORE as the supplied operator. Use Member Inquiry to search by member number for the given member number and select that member. Open a new share using the given share type and initial deposit: select the share type, fill the initial deposit, then click Continue to reach the confirm screen. Do not extract any hidden fields or tokens for this task. Immediately click Open Share on the confirm screen to submit. Declare the goal DONE as soon as the new share is shown, using a suggested_success_condition grounded in stable page text such as a heading (never a value you just extracted).",
